# Google Maps API key (required)
# Enable "Places API (New)" and the other services you use on the key:
# https://console.cloud.google.com/apis/library
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# HTTP transport port (scripts/start-http.sh and default server port)
MCP_SERVER_PORT=3000

# HTTP bind address (0.0.0.0 = all interfaces)
MCP_SERVER_HOST=127.0.0.1

# Optional: comma-separated allowlist of exposed tools (omit or "*" = all 18)
# GOOGLE_MAPS_ENABLED_TOOLS=maps_search_places,maps_place_details,maps_geocode
