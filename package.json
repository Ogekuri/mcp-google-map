{
  "name": "mcp-google-map",
  "version": "0.1.0",
  "description": "Google Maps MCP server — 18 tools for AI agents: geocoding, Places API (New) search with server-side filters, directions, distance matrix and more, via stdio or Streamable HTTP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-google-map": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    ".env.example"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.unit.test.ts",
    "test:e2e": "tsx tests/smoke.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "google",
    "google-maps",
    "maps",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "places",
    "places-api-new",
    "geocoding",
    "directions",
    "geoscout"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ogekuri/mcp-google-map.git"
  },
  "bugs": {
    "url": "https://github.com/Ogekuri/mcp-google-map/issues"
  },
  "homepage": "https://github.com/Ogekuri/mcp-google-map#readme",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@googlemaps/places": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yargs": "^17.7.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/yargs": "^17.0.33",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
